  "lines": [
    {
      "text": "Children of the land, do you hear?",
      "time": "00:29.638",
      "end": "00:34.578",
      "words": [
        "00:29.638",
        "00:30.426",
        "00:30.846",
        "00:31.279",
        "00:32.073",
        "00:32.410",
        "00:32.819"
      ]
    },
    {
      "text": "Echoes of truths that once rang clear.",
      "time": "00:36.040",
      "end": "00:41.137",
      "words": [
        "00:36.040",
        "00:36.916",
        "00:37.212",
        "00:38.141",
        "00:38.428",
        "00:38.769",
        "00:39.285"
      ]
    },
    {
      "text": "Two souls intertwined,",
      "time": "00:41.620",
      "end": "00:44.946",
      "words": [
        "00:41.620",
        "00:42.013",
        "00:42.439"
      ]
    },
    {
      "text": "One true love they did find,",
      "time": "00:45.249",
      "end": "00:48.020",
      "words": [
        "00:45.249",
        "00:45.574",
        "00:45.939",
        "00:46.372",
        "00:46.766",
        "00:47.224"
      ]
    },
    {
      "text": "Bringing land and heavens near.",
      "time": "00:48.105",
      "end": "00:54.433",
      "words": [
        "00:48.105",
        "00:48.781",
        "00:50.885",
        "00:51.212",
        "00:52.121"
      ]
    },
    {
      "text": "But flames that burn full bright soon fell dark.",
      "time": "00:54.811",
      "end": "01:01.014",
      "words": [
        "00:54.811",
        "00:55.146",
        "00:55.765",
        "00:56.038",
        "00:56.405",
        "00:56.823",
        "00:57.578",
        "00:57.996",
        "00:58.424"
      ]
    },
    {
      "text": "Memories dimmed by shadowed hearts.",
      "time": "01:01.520",
      "end": "01:06.734",
      "words": [
        "01:01.520",
        "01:02.832",
        "01:03.556",
        "01:03.940",
        "01:04.780"
      ]
    },
    {
      "text": "In the waxing gloom,",
      "time": "01:07.224",
      "end": "01:10.474",
      "words": [
        "01:07.224",
        "01:07.584",
        "01:07.978",
        "01:09.636"
      ]
    },
    {
      "text": "Did wane the lover's moon,",
      "time": "01:10.820",
      "end": "01:13.963",
      "words": [
        "01:10.820",
        "01:11.163",
        "01:11.524",
        "01:12.047",
        "01:12.928"
      ]
    },
    {
      "text": "Watching as their worlds drift apart.",
      "time": "01:14.395",
      "end": "01:19.737",
      "words": [
        "01:14.395",
        "01:15.207",
        "01:15.561",
        "01:16.034",
        "01:16.836",
        "01:17.229"
      ]
    },
    {
      "text": "One soul's cry, a passion dwelling within.",
      "time": "01:24.194",
      "end": "01:34.577",
      "words": [
        "01:24.194",
        "01:24.874",
        "01:25.602",
        "01:27.567",
        "01:27.921",
        "01:28.749",
        "01:29.520"
      ]
    },
    {
      "text": "Sacrifice, a final plea to her kin!",
