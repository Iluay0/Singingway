  ],
  "lines": [
    {
      "text": "Children of the land, do you hear?",
      "time": "00:29.008",
      "end": "00:33.948",
      "words": [
        "00:29.008",
        "00:29.796",
        "00:30.216",
        "00:30.649",
        "00:31.443",
        "00:31.780",
        "00:32.189"
      ]
    },
    {
      "text": "Echoes of truths that once rang clear.",
      "time": "00:35.410",
      "end": "00:40.507",
      "words": [
        "00:35.410",
        "00:36.286",
        "00:36.582",
        "00:37.511",
        "00:37.798",
        "00:38.139",
        "00:38.655"
      ]
    },
    {
      "text": "Two souls intertwined,",
      "time": "00:40.990",
      "end": "00:44.316",
      "words": [
        "00:40.990",
        "00:41.383",
        "00:41.809"
      ]
    },
    {
      "text": "One true love they did find,",
      "time": "00:44.619",
      "end": "00:47.390",
      "words": [
        "00:44.619",
        "00:44.944",
        "00:45.309",
        "00:45.742",
        "00:46.136",
        "00:46.594"
      ]
    },
    {
      "text": "Bringing land and heavens near.",
      "time": "00:47.475",
      "end": "00:53.803",
      "words": [
        "00:47.475",
        "00:48.151",
        "00:50.255",
        "00:50.582",
        "00:51.491"
      ]
    },
    {
      "text": "But flames that burn full bright soon fell dark.",
      "time": "00:54.181",
      "end": "01:00.384",
      "words": [
        "00:54.181",
        "00:54.516",
        "00:55.135",
        "00:55.408",
        "00:55.775",
        "00:56.193",
        "00:56.948",
        "00:57.366",
        "00:57.794"
      ]
    },
    {
      "text": "Memories dimmed by shadowed hearts.",
      "time": "01:00.890",
      "end": "01:06.104",
      "words": [
        "01:00.890",
        "01:02.202",
        "01:02.926",
        "01:03.310",
        "01:04.150"
      ]
    },
    {
      "text": "In the waxing gloom,",
      "time": "01:06.594",
      "end": "01:09.844",
      "words": [
        "01:06.594",
        "01:06.954",
        "01:07.348",
        "01:09.006"
      ]
    },
    {
      "text": "Did wane the lover's moon,",
      "time": "01:10.190",
      "end": "01:13.333",
      "words": [
        "01:10.190",
        "01:10.533",
        "01:10.894",
        "01:11.417",
        "01:12.298"
      ]
    },
    {
      "text": "Watching as their worlds drift apart.",
      "time": "01:13.765",
      "end": "01:19.107",
      "words": [
        "01:13.765",
        "01:14.577",
        "01:14.931",
        "01:15.404",
        "01:16.206",
        "01:16.599"
      ]
    },
    {
      "text": "One soul's cry, a passion dwelling within.",
      "time": "01:23.564",
      "end": "01:33.947",
      "words": [
        "01:23.564",
        "01:24.244",
        "01:24.972",
        "01:26.937",
        "01:27.291",
        "01:28.119",
        "01:28.890"
      ]
    },
    {
      "text": "Sacrifice, a final plea to her kin!",
      "time": "01:36.159",
      "end": "01:46.493",
      "words": [
        "01:36.159",
        "01:39.799",
        "01:40.091",
        "01:40.868",
        "01:41.332",
        "01:41.686",
        "01:42.580"
      ]
    },
    {
      "text": "Yet this bond of hope,",
      "time": "01:48.299",
      "end": "01:51.650",
      "words": [
        "01:48.299",
        "01:48.627",
        "01:49.020",
        "01:49.920",
        "01:50.715"
      ]
    },
    {
      "text": "By treachery was broke,",
      "time": "01:51.946",
      "end": "01:54.895",
      "words": [
        "01:51.946",
        "01:52.185",
        "01:53.333",
        "01:53.721"
      ]
    },
    {
      "text": "Scattering her words to the wind.",
      "time": "01:55.368",
      "end": "02:01.453",
      "words": [
        "01:55.368",
        "01:56.544",
        "01:56.936",
        "01:57.945",
        "01:58.241",
        "01:58.673"
      ]
    },
    {
      "text": "Swelling overlong, seas of blood, are a song",
      "time": "02:30.436",
      "end": "02:40.937",
      "words": [
        "02:30.436",
        "02:32.250",
        "02:36.067",
        "02:36.504",
        "02:36.817",
        "02:39.081",
        "02:39.377",
        "02:39.810"
      ]
    },
    {
      "text": "And death an afterthought,",
      "time": "02:42.557",
      "end": "02:48.210",
      "words": [
        "02:42.557",
        "02:42.901",
        "02:44.085",
        "02:44.452"
      ]
    },
    {
      "text": "To those who fight for naught.",
      "time": "02:48.603",
      "end": "02:54.026",
      "words": [
        "02:48.603",
        "02:48.938",
        "02:50.203",
        "02:50.515",
        "02:51.239",
        "02:52.140"
      ]
    },
    {
      "text": "A throne, lying empty...",
      "time": "02:54.506",
      "end": "03:06.282",
      "words": [
        "02:54.506",
        "02:55.157",
        "02:59.834",
        "03:01.437"
      ]
    },
    {
      "text": "A reign incomplete.",
      "time": "03:06.740",
      "end": "03:18.621",
      "words": [
        "03:06.740",
        "03:07.542",
        "03:12.159"
      ]
    },
    {
      "text": "Alone for eternity...",
      "time": "03:19.144",
      "end": "03:30.905",
      "words": [
        "03:19.144",
        "03:24.418",
        "03:25.344"
      ]
    },
    {
      "text": "A pain without cease.",
      "time": "03:31.490",
      "end": "03:43.860",
      "words": [
        "03:31.490",
        "03:32.141",
        "03:36.824",
        "03:38.637"
      ]
    },
    {
      "text": "Children of the land answer this:",
      "time": "04:15.273",
      "end": "04:20.616",
      "words": [
        "04:15.273",
        "04:16.109",
        "04:16.430",
        "04:16.862",
        "04:17.684",
        "04:18.374"
      ]
    },
    {
      "text": "Why must you turn to empty bliss?",
      "time": "04:21.419",
      "end": "04:26.325",
      "words": [
        "04:21.419",
        "04:21.715",
        "04:22.076",
        "04:22.429",
        "04:23.242",
        "04:23.684",
        "04:24.390"
      ]
    },
    {
      "text": "Tell me why break trust?",
      "time": "04:26.756",
      "end": "04:29.946",
      "words": [
        "04:26.756",
        "04:27.072",
        "04:27.509",
        "04:28.354",
        "04:29.061"
      ]
    },
    {
      "text": "Why turn the past to dust?",
      "time": "04:30.302",
      "end": "04:33.191",
      "words": [
        "04:30.302",
        "04:30.568",
        "04:30.895",
        "04:31.294",
        "04:31.679",
        "04:32.072"
      ]
    },
    {
      "text": "Seeking solace in the abyss.",
      "time": "04:33.622",
      "end": "04:38.597",
      "words": [
        "04:33.622",
        "04:34.347",
        "04:35.207",
        "04:35.881",
        "04:36.349"
      ]
    },
    {
      "text": "Tell me why create a circle none can break?",
      "time": "04:38.990",
      "end": "04:45.655",
      "words": [
        "04:38.990",
        "04:39.325",
        "04:39.733",
        "04:40.626",
        "04:42.600",
        "04:42.893",
        "04:43.656",
        "04:44.001",
        "04:44.814"
      ]
    },
    {
      "text": "Why must you let go the life you were bestowed?",
      "time": "04:45.999",
      "end": "04:51.595",
      "words": [
        "04:45.999",
        "04:46.383",
        "04:46.752",
        "04:47.113",
        "04:47.561",
        "04:48.760",
        "04:49.072",
        "04:49.490",
        "04:49.834",
        "04:50.260"
      ]
    },
    {
      "text": "This I'll fear I'll never know!",
      "time": "04:52.110",
      "end": "04:59.243",
      "words": [
        "04:52.110",
        "04:52.519",
        "04:52.928",
        "04:53.295",
        "04:53.801",
        "04:55.274"
      ]
    },
    {
      "text": "Never know...",
      "time": "05:00.288",
      "end": "05:06.497",
      "words": [
        "05:00.288",
        "05:02.654"
      ]
    }
  ]
}
