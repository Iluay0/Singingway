      "end": "01:22.633",
      "words": [
        "01:18.587",
        "01:19.323",
        "01:19.868",
        "01:20.056",
        "01:20.261",
        "01:20.663",
        "01:21.053",
        "01:21.385",
        "01:21.667"
      ]
    },
    {
