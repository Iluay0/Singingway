      "end": "01:23.854",
      "words": [
        "01:22.315",
        "01:22.440",
        "01:22.663",
        "01:22.843",
        "01:23.050",
        "01:23.251",
        "01:23.429",
        "01:23.598"
      ]
    },
    {
      "text": "Now kneel overdweller, your lord commands,",
