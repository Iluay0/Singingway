    {
      "text": "Into the dark of an endless night,",
      "time": "01:18.102",
      "end": "01:19.275",
      "words": [
        "01:18.102",
        "01:18.330",
        "01:18.409",
        "01:18.559",
        "01:18.624",
        "01:18.730",
        "01:19.082"
      ]
    },
    {
      "text": "Where the pulse of the land offers no respite.",
