      "words": [
        "01:20.895",
        "01:20.987",
        "01:21.246",
        "01:21.415",
        "01:21.492",
        "01:21.629",
        "01:21.712",
        "01:21.778",
        "01:21.984"
      ]
    },
    {
      "text": "You whet your blades, you thirst for more.",
