      "end": "01:20.802",
      "words": [
        "01:19.332",
        "01:19.416",
        "01:19.472",
        "01:19.616",
        "01:19.700",
        "01:19.806",
        "01:20.007",
        "01:20.204",
        "01:20.375"
      ]
    },
    {
      "text": "In spite of the blood that was spilled before,",
      "time": "01:20.895",
