        "01:22.431",
        "01:23.098",
        "01:23.491",
        "01:23.903"
      ]
    },
    {
      "text": "The soul yearns for honor, and the flesh the hereafter",
      "time": "01:27.699",
      "end": "01:38.458",
      "words": [
        "01:27.699",
        "01:28.375",
        "01:29.148",
        "01:29.859",
        "01:30.681",
        "01:32.310",
        "01:32.660",
        "01:32.984",
        "01:33.761",
        "01:34.413"
      ]
    },
    {
      "text": "Look to those who walked before to lead those who walk after",
      "time": "01:38.944",
      "end": "01:50.950",
      "words": [
        "01:38.944",
        "01:39.246",
        "01:39.629",
