        "03:54.579",
        "03:56.246",
        "03:56.602",
        "03:56.967",
        "03:57.597",
        "03:58.364",
        "03:58.842"
      ]
    },
    {
      "text": "Our souls have been torn, and our bodies forsaken",
      "time": "04:03.033",
      "end": "04:13.183",
      "words": [
        "04:03.033",
        "04:03.622",
        "04:04.422",
        "04:05.185",
        "04:05.896",
        "04:07.486",
        "04:07.732",
        "04:08.152",
        "04:09.737"
      ]
    },
    {
      "text": "Bearing sins of the past, for our future is taken",
      "time": "04:14.167",
      "end": "04:24.956",
      "words": [
        "04:14.167",
        "04:14.930",
        "04:16.389",
        "04:16.705",
        "04:17.107",
        "04:18.736",
        "04:19.020",
        "04:19.358",
        "04:20.968",
        "04:21.667"
      ]
    },
    {
      "text": "War born of strife, these trials persuade us not",
      "time": "04:26.202",
      "end": "04:35.052",
      "words": [
        "04:26.202",
        "04:28.458",
        "04:28.741",
        "04:29.103",
        "04:30.308",
        "04:30.642",
        "04:31.224",
        "04:31.868",
        "04:32.509"
      ]
    },
    {
      "text": "(Feel what? Learn what?)",
      "time": "04:32.213",
      "end": "04:37.715",
      "words": [
        "04:32.213",
        "04:33.641",
        "04:35.159",
        "04:36.681"
      ]
    },
    {
      "text": "Words without sound, these lies betray our thoughts",
      "time": "04:38.143",
      "end": "04:47.434",
      "words": [
        "04:38.143",
        "04:40.483",
        "04:41.144",
        "04:42.323",
        "04:42.661",
        "04:43.063",
        "04:43.762",
        "04:44.529"
      ]
    },
    {
      "text": "Mired by a plague of doubt, the Land, she mourns",
      "time": "04:50.180",
      "end": "04:59.225",
      "words": [
        "04:50.180",
        "04:52.455",
        "04:52.756",
        "04:53.113",
