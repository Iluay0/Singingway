        "03:44.945",
        "03:45.334",
        "03:45.672",
        "03:46.420",
        "03:47.236"
      ]
    },
    {
      "text": "Still deaf to our cries, lost in hope we lie defeated",
      "time": "03:51.698",
      "end": "04:02.344",
      "words": [
        "03:51.698",
        "03:52.439",
        "03:53.205",
