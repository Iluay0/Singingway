        "00:07.237",
        "00:08.026",
        "00:09.023",
        "00:09.843"
      ]
    },
    {
      "text": "Release your hands, for your will drags us under.",
      "time": "00:15.185",
      "end": "00:27.459",
      "words": [
        "00:15.185",
        "00:17.627",
        "00:18.449",
        "00:20.187",
