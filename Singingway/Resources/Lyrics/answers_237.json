      "text": "Answer",
      "time": "05:56.112",
      "end": "05:57.546",
      "words": [
        "05:56.112"
      ]
    },
    {
      "text": "(Look)",
      "time": "05:57.623",
      "end": "05:58.306",
      "words": [
        "05:57.623"
      ]
    },
    {
      "text": "Answer",
      "time": "05:58.358",
      "end": "05:59.900",
      "words": [
        "05:58.358"
      ]
    },
    {
      "text": "(Think)",
      "time": "05:59.962",
      "end": "06:00.551",
      "words": [
        "05:59.962"
      ]
    },
    {
      "text": "Answer Together",
      "time": "06:00.639",
      "end": "06:07.062",
      "words": [
        "06:00.639",
        "06:02.216"
      ]
    },
    {
      "text": "Thy Life is a riddle, to bear rapture and sorrow",
      "time": "06:07.594",
      "end": "06:18.027",
      "words": [
        "06:07.594",
        "06:08.259",
        "06:09.003",
        "06:09.691",
        "06:10.431",
        "06:11.985",
        "06:12.286",
        "06:12.706",
        "06:14.179",
        "06:14.913"
      ]
    },
    {
      "text": "To listen, to suffer, to entrust unto tomorrow",
      "time": "06:18.812",
      "end": "06:29.222",
      "words": [
        "06:18.812",
        "06:19.479",
        "06:20.945",
        "06:21.688",
        "06:23.223",
        "06:23.622",
        "06:24.660",
        "06:25.677"
      ]
    },
    {
      "text": "In one fleeting moment, from the Land doth life flow",
      "time": "06:30.038",
      "end": "06:40.654",
      "words": [
        "06:30.038",
        "06:30.672",
        "06:31.384",
        "06:32.852",
        "06:34.492",
        "06:34.854",
        "06:35.169",
        "06:35.903",
        "06:36.665",
        "06:37.521"
      ]
    },
    {
      "text": "Yet in one fleeting moment, for anew it doth grow",
      "time": "06:41.259",
      "end": "06:51.662",
      "words": [
        "06:41.259",
        "06:41.571",
        "06:41.954",
        "06:43.418",
        "06:44.162",
        "06:45.695",
        "06:46.185",
        "06:47.202",
        "06:47.924",
        "06:48.635"
      ]
    },
    {
      "text": "In the same fleeting moment",
      "time": "06:52.498",
      "end": "06:56.779",
      "words": [
        "06:52.498",
        "06:52.840",
        "06:53.200",
        "06:54.664",
        "06:55.438"
      ]
    },
    {
      "text": "Thou must live",
      "time": "06:57.091",
      "end": "06:58.443",
      "words": [
        "06:57.091",
        "06:57.474",
        "06:57.886"
      ]
    },
    {
      "text": "Die",
      "time": "06:58.653",
      "end": "06:59.197",
      "words": [
        "06:58.653"
      ]
    },
    {
      "text": "And know",
      "time": "06:59.453",
      "end": "07:04.359",
      "words": [
        "06:59.453",
        "07:00.459"
      ]
    }
