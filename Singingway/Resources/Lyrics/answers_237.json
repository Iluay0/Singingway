        "00:20.939",
        "00:22.689",
        "00:22.971",
        "00:23.476"
      ]
    },
    {
      "text": "My legs grow tired, tell us where must we wander?",
      "time": "00:28.859",
      "end": "00:41.058",
      "words": [
        "00:28.859",
        "00:29.622",
        "00:31.222",
        "00:32.033",
        "00:33.887",
        "00:34.186",
        "00:34.679",
        "00:35.526",
        "00:36.407",
        "00:37.235"
      ]
    },
    {
      "text": "How can we carry on if redemption's beyond us?",
      "time": "00:42.554",
      "end": "00:54.477",
      "words": [
        "00:42.554",
        "00:42.829",
        "00:43.267",
        "00:45.056",
        "00:45.817",
        "00:47.527",
        "00:48.028",
        "00:50.100",
        "00:51.839"
      ]
    },
    {
      "text": "To all of my children in whom Life flows abundant.",
      "time": "01:05.348",
      "end": "01:15.550",
      "words": [
        "01:05.348",
        "01:06.059",
        "01:06.748",
        "01:07.410",
        "01:08.143",
        "01:09.643",
        "01:10.047",
        "01:10.441",
        "01:11.148",
        "01:12.011"
      ]
    },
    {
      "text": "To all of my children to whom Death hath passed his judgement",
      "time": "01:16.567",
      "end": "01:26.886",
      "words": [
        "01:16.567",
        "01:17.246",
        "01:17.889",
        "01:18.541",
        "01:19.341",
        "01:21.006",
